# Copy to .env and fill in secrets / machine-local values only.

# Conversation history — SQLite is fine for single-agent dev.
# Relative paths in monkeybot.yaml are already anchored to this agent root.
DB_URL=sqlite:///data/monkeybot.db
# DB_URL=postgresql://postgres:postgres@localhost:5432/monkeybot
# DB_URL=firestore://your-gcp-project/(default)

# Gemini / Vertex (pick one approach)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GCP_PROJECT_ID=your-gcp-project
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GEMINI_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# Anthropic
# ANTHROPIC_API_KEY=

# Vertex Claude
# ANTHROPIC_VERTEX_PROJECT_ID=
# ANTHROPIC_VERTEX_REGION=us-east5

# AWS Bedrock
# AWS_REGION=us-east-1

# Hugging Face
# HF_TOKEN=

# Ollama (local models — no API key needed)
# OLLAMA_BASE_URL=http://localhost:11434

# Optional web search
# TAVILY_API_KEY=
# FIRECRAWL_API_KEY=

# Scheduled loops — prefer scheduler.enabled in monkeybot.yaml for local/dev.
# Production: leave disabled on the gateway and run `python -m monkeybot.scheduler`.
# MONKEYBOT_SCHEDULER_ENABLED=1
