# Copy to .env and fill in values for your provider.
# Secrets never go in monkeybot.yaml.

# Workspace sandbox for file tools (matches paths.workspace_root in monkeybot.yaml)
MONKEYBOT_WORKSPACE_ROOT=./workspace

# Conversation history — SQLite is fine for single-agent dev.
DB_URL=sqlite:///data/monkeybot.db
# Parallel subagents (multiple concurrent task tools) need Postgres locally:
#   uv sync --extra postgres   (in the monkeybot harness repo)
# DB_URL=postgresql://postgres:postgres@localhost:5432/monkeybot

# AGENT.md resolves from the bot project root (not workspace/). Absolute paths
# are safest; relative paths work when MONKEYBOT_AGENT_ROOT is set (gateway default).
# AGENT_MD=/absolute/path/to/monkeybot_config/AGENT.md

# Optional: override subagent prompt file (defaults to same as AGENT_MD).
# Specialization is via task/context on the task tool, not per-task agent files.
# MONKEYBOT_SUBAGENT_AGENT_MD=

# Gemini / Vertex (pick one approach)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GCP_PROJECT_ID=your-gcp-project
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GEMINI_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# Anthropic
# ANTHROPIC_API_KEY=

# Vertex Claude
# ANTHROPIC_VERTEX_PROJECT_ID=
# ANTHROPIC_VERTEX_REGION=us-east5

# AWS Bedrock
# AWS_REGION=us-east-1

# Hugging Face
# HF_TOKEN=

# Optional web search
# TAVILY_API_KEY=
# FIRECRAWL_API_KEY=
