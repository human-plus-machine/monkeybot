#!/usr/bin/env bash
set -euo pipefail

echo "→ Installing monkeybot with gemini + dev extras..."
uv sync --extra gemini --extra dev

if [ ! -f .env ]; then
  cp .env.example .env
  echo "→ Created .env from .env.example — set GEMINI_API_KEY before running."
else
  echo "→ .env already exists, skipping copy."
fi

echo ""
echo "Bootstrap complete."
echo "  1. Edit .env and set GEMINI_API_KEY"
echo "  2. Run: scripts/run"
