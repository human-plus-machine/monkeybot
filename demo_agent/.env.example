# Copy to .env — secrets and machine-local overrides only.
# Paths, AGENT.md, workspace_root, and subagent personas: monkeybot_config/monkeybot.yaml
# Backend: ./run.sh  (or uv run --env-file .env -m monkeybot.gateway.main)

# --- NVIDIA (build.nvidia.com) ---
# Free key: open any model at https://build.nvidia.com/models and click "Get API Key".
# NVIDIA_API_KEY=nvapi-your-key

# --- Optional observability (run.sh starts Phoenix, Langfuse, OTel collector) ---
# MONKEYBOT_OTEL_ENABLED=true
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_METRICS_EXPORTER=none
# OTEL_LOGS_EXPORTER=none
# OTEL_SERVICE_NAME=monkeybot-gateway
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=http://localhost:3000

# Skip stacks: SKIP_OBSERVABILITY=1  SKIP_OPENSANDBOX=1
# Keep running after exit: PRESERVE_OBSERVABILITY=1  PRESERVE_OPENSANDBOX=1
