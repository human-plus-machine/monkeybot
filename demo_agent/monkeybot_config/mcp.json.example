{
  "mcpServers": {
    "browser": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "../integrations/browser-mcp",
        "python",
        "-m",
        "browser_mcp.server"
      ],
      "env": {
        "BU_NAME": "monkeybot",
        "BROWSER_MCP_PLAYBOOKS_DIR": "./workspace/skills/browser/playbooks",
        "BROWSER_MCP_SCREENSHOTS_DIR": "${MONKEYBOT_WORKSPACE_ROOT}/browser/Screenshots"
      }
    }
  }
}
