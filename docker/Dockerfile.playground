# Playground gateway image (local Docker smoke test + Cloud Run–style layout).
# Build from the repository root:
#   docker buildx build --platform linux/amd64 -f docker/Dockerfile.playground -t TAG --push .
#
# Layout:
#   /app/workspace/     — only ``data/`` and ``skills/`` (agent-facing cwd + workspace API)
#   /app/.harness/      — ``monkeybot_config/`` (not listed by playground workspace routes)
#
# Vertex: set GOOGLE_CLOUD_PROJECT / VERTEX_AI_PROJECT_ID on the service. ADC comes from the
# runtime service account — do not bake API keys into the image.
# OpenSandbox is off via SANDBOX_ENABLED=false; Cloud Run cannot run playground/agent/run.sh.

FROM python:3.12-slim

RUN pip install --no-cache-dir --upgrade pip

WORKDIR /tmp/monkeybot_pkg
COPY pyproject.toml README.md ./
COPY src ./src
ARG EXTRAS=vertex,web-search
RUN pip install --no-cache-dir ".[$EXTRAS]" && rm -rf /tmp/monkeybot_pkg

WORKDIR /
RUN mkdir -p /app/workspace/data/memory
COPY playground/agent/monkeybot_config /app/.harness/monkeybot_config
COPY playground/agent/skills /app/workspace/skills

WORKDIR /app/workspace

ENV PYTHONUNBUFFERED=1 \
    PORT=8080 \
    SANDBOX_ENABLED=false \
    MONKEYBOT_CONFIG=/app/.harness/monkeybot_config/monkeybot.yaml \
    AGENT_MD=/app/.harness/monkeybot_config/AGENT.md \
    MEMORY_STORAGE_URI=local:///app/workspace/data/memory \
    SKILLS_PATH=/app/workspace/skills \
    DB_URL=sqlite:////app/workspace/data/monkeybot.db \
    MCP_CONFIG=/app/.harness/monkeybot_config/mcp.json \
    COMMAND_ALLOWLIST_CONFIG=/app/.harness/monkeybot_config/command_allowlist.yaml

EXPOSE 8080

CMD ["python", "-m", "monkeybot.gateway.main"]
