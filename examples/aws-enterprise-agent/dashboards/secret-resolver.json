{
  "__comment": "Stub Grafana dashboard for secret-resolver signals. Extend with per-leg latency, composite-leg failure breakdown, and resolve rate panels per 1C §4.2.",
  "title": "Harness: Secret Resolver",
  "schemaVersion": 38,
  "version": 1,
  "tags": ["emonk", "harness", "secrets"],
  "timezone": "browser",
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Secret Resolutions per minute",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(emonk_secret_resolved_total[1m])) * 60",
          "legendFormat": "resolve_rate"
        }
      ],
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0}
    }
  ],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"}
}
