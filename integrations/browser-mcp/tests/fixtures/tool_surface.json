{
  "tools": [
    {
      "description": "Run up to 25 sequential browser steps in one turn.\n\nEach step is ``{do, ...}``. Allowed do values: click, input, select, press,\nclick_text, wait_for, wait_idle, goto, scroll, settle, tab, open_tab,\nfill_form, login. After each action the page settles; one observation is\nreturned at the end for the focused tab. On the first failure\n(stop_on_error=True, default) returns completed steps, failed_step, error,\nand the current observation so you can resume. login maps to browser_login\n(user-focused tab; always pass expected_origin). fill_form resolves fields\nby label (label[for], aria-label, placeholder, name, id, preceding row text).\n",
      "inputSchema": {
        "properties": {
          "observe": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Observe"
          },
          "steps": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Steps",
            "type": "array"
          },
          "stop_on_error": {
            "default": true,
            "title": "Stop On Error",
            "type": "boolean"
          },
          "tab": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Tab"
          }
        },
        "required": [
          "steps"
        ],
        "title": "browser_actArguments",
        "type": "object"
      },
      "name": "browser_act"
    },
    {
