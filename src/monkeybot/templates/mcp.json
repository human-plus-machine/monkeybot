{
  "mcpServers": {
    "example-stdio-server": {
      "enabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/path/to/workspace-readable-by-this-server"
      ],
      "env": {
        "NODE_ENV": "production",
        "EXAMPLE_SECRET": "${MY_SECRET_ENV_VAR}"
      }
    },
    "example-streamable-http-server": {
      "enabled": false,
      "url": "https://your-mcp-host.example.com/mcp",
      "headers": {
        "Authorization": "Bearer ${MY_STATIC_BEARER_TOKEN}"
      }
    },
    "example-oauth-client-credentials-server": {
      "enabled": false,
      "url": "https://your-mcp-host.example.com/mcp",
      "auth": {
        "flow": "client_credentials",
        "token_url": "https://identity.provider.example.com/oauth2/token",
        "client_id": "${OAUTH_CLIENT_ID}",
        "client_secret": "${OAUTH_CLIENT_SECRET}",
        "scope": "read:tools write:tools",
        "client_auth_method": "body"
      }
    },
    "example-oauth-password-server": {
      "enabled": false,
      "url": "https://your-mcp-host.example.com/mcp",
      "auth": {
        "flow": "password",
        "token_url": "https://identity.provider.example.com/oauth2/token",
        "username": "${BOT_USERNAME}",
        "password": "${BOT_PASSWORD}",
        "client_id": "${OAUTH_CLIENT_ID}",
        "client_secret": "${OAUTH_CLIENT_SECRET}"
      }
    }
  }
}
