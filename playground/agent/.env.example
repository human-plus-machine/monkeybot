# Copy to .env and run the gateway from this directory (playground/agent/).
# Backend: uv run --env-file .env -m monkeybot.gateway.main
# Frontend: cd ../chat-ui && npm run dev

# --- Core ---
PORT=8787                      # 8787 avoids common clashes with other apps on 8080
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

DB_URL=sqlite:///./data/monkeybot.db
# History schema uses typed content blocks. If you see a startup error about a
# legacy schema, delete the DB file and restart: rm -f ./data/monkeybot.db

MODEL_PROVIDER=fake            # gemini | openai | anthropic | vertex-claude | fake
MODEL_NAME=gemini-3-flash

# Paths are relative to playground/agent/ when you start the process from here.
AGENT_MD=./AGENT.md
MEMORY_PATH=./data/memory
SKILLS_PATH=./skills
MCP_CONFIG=./config/mcp.json
COMMAND_TIERS_CONFIG=./config/command_tiers.yaml

# --- Model generation (Gemini / OpenAI) ---
# MODEL_TEMPERATURE=0.7
# MODEL_MAX_TOKENS=60000
# MODEL_CONTEXT_WINDOW=1000000   # used for summarisation trigger (tokens)
# MODEL_THINKING_BUDGET=-1       # Gemini only: -1 = model default, 0 = off, N = token budget
# MAX_TURNS=50                   # hard cap on inner tool-call turns per request

# --- Gemini / Vertex AI ---
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# VERTEX_AI_PROJECT_ID=your-gcp-project
# GCP_PROJECT_ID=your-gcp-project          # alias for VERTEX_AI_PROJECT_ID
# GOOGLE_CLOUD_PROJECT=your-gcp-project    # alias accepted by google-auth
# VERTEX_AI_LOCATION=us-central1           # override region (preview models default to global)
# GOOGLE_CLOUD_LOCATION=us-central1        # alias for VERTEX_AI_LOCATION
# GEMINI_API_KEY=                          # only for AI-Studio mode (non-Vertex)

# --- OpenAI ---
# OPENAI_API_KEY=

# --- Anthropic (direct) ---
# ANTHROPIC_API_KEY=

# --- Anthropic on Vertex ---
# ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project
# ANTHROPIC_VERTEX_REGION=us-east5

# --- Context curator ---
# Optional secondary LLM pass before each main model call (when thresholds met).
# Narrows which INDEX.md lines + disk search snippets and which skills are injected into the system prompt.
# Subagents skip curation. On curator failure, memory/skills sections are omitted for that request.
# The curator always uses a separate GeminiProvider(thinking_budget=0, max_output_tokens=1024)
# so it never inherits MODEL_THINKING_BUDGET from the main agent.
# CONTEXT_CURATION_ENABLED=1
# CONTEXT_CURATION_SKILL_THRESHOLD=4     # run curation when skills > this
# CONTEXT_CURATION_MEMORY_THRESHOLD=8    # or when INDEX.md lines > this
# CONTEXT_CURATOR_MODEL=                 # defaults to MODEL_NAME when unset
# CONTEXT_CURATION_TIMEOUT_SEC=10        # wall-clock cap on the curator LLM stream only
# CONTEXT_CURATION_MAX_MEMORY_LINES=12   # max lines the curator may select
# CONTEXT_CURATION_MAX_SKILLS=5          # max skills the curator may select
# CONTEXT_CURATION_SEARCH_MAX_HITS=8     # max file-search snippets fed into the curator

# --- Memory hook ---
# MONKEYBOT_MEMORY_HOOK_ENABLED=true     # set to false to disable all memory read/write hooks

# --- Subagent (task tool) ---
# SUBAGENT_TIMEOUT_SEC=600               # wall-clock cap for a single task subagent run
# SUBAGENT_MAX_TURNS=25                  # inner turn cap for subagents (falls back to MAX_TURNS)
# MONKEYBOT_SUBAGENT_AGENT_MD=          # override AGENT.md path inside a subagent process

# --- Gateway / SSE ---
# PENDING_RESPONSE_TIMEOUT_SEC=300       # how long to wait for a user-confirm response
# SSE_REPLAY_MAX=256                     # max events replayed to a reconnecting SSE client
# GRACEFUL_SHUTDOWN_TIMEOUT_SEC=5        # uvicorn graceful shutdown window

# --- Tool policy ---
# MONKEYBOT_TOOL_DENIED_PATTERNS=        # comma-separated substrings blocked in tool args
