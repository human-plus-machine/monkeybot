# Copy to .env and run the gateway from this directory (playground/agent/).
# Backend: uv run --env-file .env -m monkeybot.gateway.main
# Frontend: cd ../chat-ui && npm run dev

# 8787 avoids common clashes with other apps on 8080.
PORT=8787
LOG_LEVEL=INFO

DB_URL=sqlite:///./data/monkeybot.db
# History schema no longer has tool_name / tool_call_id columns (typed content blocks).
# If you see a startup error about a legacy schema, delete this DB file and restart:
#   rm -f ./data/monkeybot.db

MODEL_PROVIDER=fake
MODEL_NAME=gemini-3-flash

# Paths are relative to playground/agent/ when you start the process from here.
AGENT_MD=./AGENT.md
MEMORY_PATH=./data/memory
SKILLS_PATH=./skills

MCP_CONFIG=./config/mcp.json
COMMAND_TIERS_CONFIG=./config/command_tiers.yaml

# --- Context curator (optional secondary LLM) ---
# When enabled, the gateway calls a small JSON completion before the main model to pick which
# INDEX.md lines and skills appear in the system prompt (only if skill/memory counts exceed thresholds).
# Subagents skip curation. On curator failure, memory/skills sections are omitted for that request.
# Uses the same provider as the main agent unless CONTEXT_CURATOR_MODEL is set.
# CONTEXT_CURATION_ENABLED=1
# CONTEXT_CURATION_SKILL_THRESHOLD=4
# CONTEXT_CURATION_MEMORY_THRESHOLD=8
# CONTEXT_CURATOR_MODEL=
# CONTEXT_CURATION_TIMEOUT_SEC=12
# CONTEXT_CURATION_MAX_MEMORY_LINES=12
# CONTEXT_CURATION_MAX_SKILLS=5
# CONTEXT_CURATION_SEARCH_MAX_HITS=8

# For real Gemini / Vertex later, set MODEL_PROVIDER=gemini and uncomment:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# VERTEX_AI_PROJECT_ID=your-gcp-project
# Preview / experimental model ids (e.g. *-preview) default to Vertex location **global**
# unless you set VERTEX_AI_LOCATION or GOOGLE_CLOUD_LOCATION explicitly.
# VERTEX_AI_LOCATION=us-central1
