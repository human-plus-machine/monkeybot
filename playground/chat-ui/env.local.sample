# Copy to .env.local (Vite loads it automatically).
# Start the backend from playground/agent/ (PORT defaults to 8787 there).
VITE_GATEWAY_TARGET=http://127.0.0.1:8787

# Observability tab — links to local Docker stack (run.sh starts Phoenix + Langfuse).
VITE_PHOENIX_URL=http://localhost:6006
VITE_LANGFUSE_URL=http://localhost:3000
