# Copy to .env — docker compose loads it automatically (see docker-compose.yml).

# LLM provider API key (required for Gemini)
GEMINI_API_KEY=

# Build-time: pip extras (set before `docker compose build`)
# EXTRAS=gemini,gcs,postgres

# Sandbox overlay only — path to OpenSandbox server config (host path, mounted read-only)
# OPENSANDBOX_CONFIG=./docker/opensandbox.docker.toml

# Optional overrides (env wins over monkeybot_config/monkeybot.yaml)
# DB_URL=sqlite:////app/data/monkeybot.db
# MEMORY_STORAGE_URI=local:///app/data/memory
# SANDBOX_ENABLED=false
