# ── Required ──────────────────────────────────────────────────────────────────
MODEL_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here

# ── Storage (defaults work for local dev) ─────────────────────────────────────
DB_URL=sqlite:///data/monkeybot.db
MEMORY_PATH=./data/memory
SKILLS_PATH=./.agents/skills

# ── Bot identity ──────────────────────────────────────────────────────────────
AGENT_MD_PATH=./bots/example-bot/AGENT.md
MEMORY_MD_PATH=./bots/example-bot/MEMORY.md

# ── Optional ──────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# HITL_ENABLED=false
# RULES_PATH=./bots/example-bot/config.yaml
# LOG_LEVEL=INFO
# PORT=8080
# WEBHOOK_TOKEN=your-webhook-token-here
