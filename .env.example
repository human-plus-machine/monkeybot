# MonkeyBot v2 (SSE gateway) — copy to .env and adjust.
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-2.5-flash

DB_URL=sqlite:///data/monkeybot.db
MEMORY_PATH=./data/memory
SKILLS_PATH=./.agents/skills
AGENT_MD=./bots/example-bot/AGENT.md

MCP_CONFIG=./config/mcp.json
COMMAND_TIERS_CONFIG=./config/command_tiers.yaml

LOG_LEVEL=INFO
PORT=8080

# Context curator — optional secondary LLM pass before each main model call (when thresholds met).
# Narrows which INDEX.md lines + disk search snippets and which skills are injected into the system prompt.
# Subagents never use curation. On failure, memory/skills sections are omitted (AGENT.md + harness unchanged).
# CONTEXT_CURATION_ENABLED=1
# CONTEXT_CURATION_SKILL_THRESHOLD=4
# CONTEXT_CURATION_MEMORY_THRESHOLD=8
# CONTEXT_CURATOR_MODEL=
# CONTEXT_CURATION_TIMEOUT_SEC=12
# CONTEXT_CURATION_MAX_MEMORY_LINES=12
# CONTEXT_CURATION_MAX_SKILLS=5
# CONTEXT_CURATION_SEARCH_MAX_HITS=8

# Gemini / Vertex (when MODEL_PROVIDER=gemini)
# GEMINI_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=
# VERTEX_AI_PROJECT_ID=

# Optional: comma-separated substrings blocked in tool args (unset = sensible defaults)
# MONKEYBOT_TOOL_DENIED_PATTERNS=
