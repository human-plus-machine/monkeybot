# MonkeyBot v2 (SSE gateway) — copy to .env and adjust.
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-2.5-flash

DB_URL=sqlite:///data/monkeybot.db
MEMORY_PATH=./data/memory
SKILLS_PATH=./.agents/skills
AGENT_MD=./bots/example-bot/AGENT.md

MCP_CONFIG=./config/mcp.json
COMMAND_TIERS_CONFIG=./config/command_tiers.yaml

LOG_LEVEL=INFO
PORT=8080

# Gemini / Vertex (when MODEL_PROVIDER=gemini)
# GEMINI_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=
# VERTEX_AI_PROJECT_ID=

# Optional: comma-separated substrings blocked in tool args (unset = sensible defaults)
# MONKEYBOT_TOOL_DENIED_PATTERNS=
