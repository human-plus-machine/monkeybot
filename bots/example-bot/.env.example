# Example bot — copy to .env and adjust paths (relative to repo root when running from here).
# Run gateway: uv run --env-file .env -m monkeybot.gateway.main
# (from repo root, with PYTHONPATH=src or editable install)

PORT=8080
DB_URL=sqlite:///./data/monkeybot.db
MODEL_PROVIDER=fake
MODEL_NAME=gemini-2.5-flash

AGENT_MD=./bots/example-bot/AGENT.md
MEMORY_PATH=./bots/example-bot
SKILLS_PATH=./.agents/skills

MCP_CONFIG=./config/mcp.json
COMMAND_TIERS_CONFIG=./config/command_tiers.yaml

# Optional substring deny list (comma-separated). Unset = defaults (rm -rf, /etc/passwd, DROP TABLE).
# MONKEYBOT_TOOL_DENIED_PATTERNS=
